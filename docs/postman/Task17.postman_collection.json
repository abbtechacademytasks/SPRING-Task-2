    {
      "name": "History keeps last five",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/recent"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Five users in order',()=>{",
              "const a=pm.response.json();pm.expect(a.map(u=>u.id)).to.eql([5,4,3,2,1].map(i=>Number(pm.collectionVariables.get('u'+i))));",
              "pm.expect(a.length).to.eql(5);a.forEach(u=>pm.expect(u.email).to.be.a('string'));});"
            ]
          }
        }
      ]
    },
