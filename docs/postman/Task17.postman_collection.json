{
  "info": {
    "name": "Task17 Bean Scopes and DI",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run against final Task17 JAR with a fresh cookie jar. Default localhost:8082."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082/api/v1/user-info"
    }
  ],
  "item": [
    {
      "name": "01 Qualifier - two Mock User entries",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/all"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Two Mock Users',()=>{const a=pm.response.json();pm.expect(a.length).to.eql(2);a.forEach(u=>pm.expect(u.fullName).to.eql('Mock User'));});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 New client has empty history",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/recent"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('New session is empty',()=>pm.expect(pm.response.json()).to.eql([]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create user 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/create",
        "body": {
          "mode": "raw",
          "raw": "{\"fullName\": \"Task17 User 1\", \"email\": \"task17-1@example.com\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "const u=pm.response.json();pm.collectionVariables.set('u1',u.id);pm.collectionVariables.set('body1',JSON.stringify(u));",
              "pm.test('Created fields',()=>{pm.expect(u.fullName).to.eql('Task17 User 1');pm.expect(u.active).to.eql(true);pm.expect(u.createdAt).to.be.a('string');});"
            ]
          }
        }
      ]
    },
